#!/bin/bash

### [ POSTCONVERT FUNC ] ###
PostConvert()
{
    #$1 = Filena Original
    #$2 = FFMPEG Exit Code
    #$3 = Filename Without Extencion
    #$4 = Number of File Finish

    SIZEINPUT=$(stat -c %s "$1")
    SIZEOUTPUT=$(stat -c %s "OUT/$3.mp4")

    # Set Exit Code to OK or Fail, Delete Orginal File and Send Result to Telegram
        if [ $2 -eq 0 ]; then
            EXIT='OK'
            rm "$1"
            mv "OUT/$3.mp4" "$3.mp4" 
            chmod 777 "$3.mp4" 
            TBots ACTION "$WHOIAM" "\"$1\" is <b>DONE: [$4/$COUNT]</b>" 
        else
            EXIT='FAIL'
            TBots ERROR "$WHOIAM" "\"$1\" is <b>FAIL: [$4/$COUNT]</b>" 
            chmod 777 "OUT/$3.mp4" #
        fi
   
    SIZEINPUT=$(($SIZEINPUT/1048576))
    SIZEOUTPUT=$(($SIZEOUTPUT/1048576))
    NAME=$1

    echo "\"$NAME\",$SIZEINPUT,$SIZEOUTPUT,$EXIT" >> OUT/Log.csv
}

