### [ FFMPEG ] ####################################################################################

#Set Vars
DIR=./OUT
FULL_PATH=$(pwd)
WHOIAM="<b>[ PRODUCTION.FFMpeg ]</b>"
TASK="<b>TASK</b> $FULL_PATH"
COUNT=$(ls | wc -l )
let J=0

#Send Task Init Message
TBots INFO "$WHOIAM" "$TASK is STARTED <b>[$COUNT FILES]</b>"

#Verify Output Directory
if [ -d $DIR ]
then
    TBots ACTION "$WHOIAM" "OUTPUT Directory set to $FULL_PATH/OUT"
else
    mkdir OUT
    TBots ACTION "$WHOIAM" "OUTPUT Directory set to $FULL_PATH/OUT"
fi

#Create Output Log File
touch OUT/Log.csv
echo "TASK:," >> OUT/Log.csv
echo "$FULL_PATH ($COUNT Files)," >> OUT/Log.csv
echo ",,," >> OUT/Log.csv
echo "File Name,Input Size (MB),Output Size (MB),Exit" >> OUT/Log.csv

while [ -n "$1" ]; do 

    COMMAND=$1   
 
    case "$COMMAND" in
 
        480p)
            TBots INFO "$WHOIAM" "480p Profile is <b>SET</b>"

            for i in *.*; do
                filename=$(basename "$i")    
                extension="${filename##*.}"
                filename="${filename%.*}"
                #filename=FileName "$i"
                let J++

                TBots ACTION "$WHOIAM" "<b>[$J/$COUNT] CONVERTING:</b> \"$i\"" 
                ffmpeg -i "$i" -s hd480 -c:v libx264 -crf 23 -c:a aac -strict -2 "OUT/$filename.mp4"
                PostConvert "$i" $? "$filename" $J
            done

            TBots ACTION "$WHOIAM" "TASK $FULL_PATH is <b>DONE</b>"             
            mv "OUT/Log.csv" "Log.csv" 
            chmod 777 "Log.csv"
            rm -r OUT
            ;; 

        720p)
            ;; 
    
    #   *) 
    #       echo "OPTION [ $1 ] NOT RECOGNIZED" 
    #       ;; 
 
    esac
 
    shift
 
done

